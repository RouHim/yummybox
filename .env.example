# YummyBox — runtime configuration
# All variables are optional. Set only what you need.
# AI provider keys and Bring! credentials can also be configured in the
# app's settings page (/settings), which takes precedence over these values.

# LLM provider API keys: only these six providers read a key from the
# environment. Ollama needs no key (it talks to a local `ollama serve`), and a
# custom OpenAI-compatible endpoint takes its key from the settings page.
# OpenAI
# OPENAI_API_KEY=
# Anthropic
# ANTHROPIC_API_KEY=
# Google Gemini
# GEMINI_API_KEY=
# Groq
# GROQ_API_KEY=
# DeepSeek
# DEEPSEEK_API_KEY=
# xAI
# XAI_API_KEY=

# Bring! shopping list (fallback — the settings page takes precedence)
BRING_EMAIL=
BRING_PASSWORD=

# Override SQLite data directory (default: ./data relative to working directory)
YUMMYBOX_DATA_DIR=

# Port the HTTP server listens on (default: 11341)
YUMMYBOX_PORT=

# Tracing/log filter (default: info; set to debug for verbose output)
RUST_LOG=
