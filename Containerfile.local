ARG YUMMYBOX_VERSION

# Build the SPA first: the musl cross image below has no Node.js, so build.rs
# must find a pre-built web/build/ and skip npm.
FROM docker.io/node:26-alpine AS web-build

WORKDIR /web
COPY web/package.json web/package-lock.json web/.npmrc ./
RUN npm ci
COPY web ./
RUN rm -rf build && npm run build

FROM ghcr.io/rust-cross/rust-musl-cross:x86_64-musl AS builder

WORKDIR /app
ARG YUMMYBOX_VERSION

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY web ./web
COPY build.rs ./
COPY migrations ./migrations

# Replace any local web/build/ from the build context with the freshly built SPA
RUN rm -rf ./web/build
COPY --from=web-build /web/build ./web/build

RUN YUMMYBOX_VERSION="$YUMMYBOX_VERSION" cargo build --release --target x86_64-unknown-linux-musl

FROM docker.io/debian:bookworm-slim

ENV YUMMYBOX_DATA_DIR=/data
ENV RUST_LOG=info

WORKDIR /data

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data /tmp \
    && chmod 1777 /tmp \
    && chown -R 1000:1000 /data /tmp

COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/yummybox /yummybox

EXPOSE 11341
# Runs as 1000:1000 — on TrueNAS SCALE host mounts default to 568:568,
# override at runtime with --user 568:568 or chown -R 1000:1000 /host/data (see README Troubleshooting)
USER 1000:1000

ENTRYPOINT ["/yummybox"]
